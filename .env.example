# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
WEBUI_SECRET_KEY=
VLLM_API_KEY=

WEBUI_NAME=ORGOS.AI
WEBUI_URL=http://localhost:3000
WEBUI_PORT=3000

# Pinned versions — test before bumping
OPEN_WEBUI_VERSION=v0.12.0
VLLM_VERSION=v0.31.0

# GPU server (vLLM). Qwen3-8B fits a 24GB GPU; use a larger/quantized model on bigger cards.
LLM_MODEL=Qwen/Qwen3-8B
LLM_MAX_LEN=32768
HF_TOKEN=

# Mac / dev: run Ollama natively (`ollama serve`, `ollama pull qwen3:8b`) and uncomment:
# OPENAI_API_BASE_URL=http://host.docker.internal:11434/v1
# VLLM_API_KEY=ollama
