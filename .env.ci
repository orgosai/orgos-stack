# CPU-only test profile (CI, Claude Code cloud sessions). TEST VALUES ONLY — never use in a real deployment.
POSTGRES_PASSWORD=ci-postgres-test
WEBUI_SECRET_KEY=ci-webui-secret-test
VLLM_API_KEY=ollama

WEBUI_NAME=ORGOS.AI
WEBUI_URL=http://localhost:3000
WEBUI_PORT=3000
OPEN_WEBUI_VERSION=v0.12.0

# Small model served by the `ollama` service on CPU
OPENAI_API_BASE_URL=http://ollama:11434/v1
TEST_MODEL=qwen3:1.7b

# Small embedding model to keep downloads/RAM low
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Test admin account created by the integration test on a fresh DB
TEST_ADMIN_EMAIL=admin@orgos.test
TEST_ADMIN_PASSWORD=ci-admin-test-pass
